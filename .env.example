# ==============================================================================
# Ganza (WoodApp) - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER BACKEND ENVIRONMENT VARIABLES (Configured in Render.com Dashboard)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
CORS_ORIGIN="https://ganza-app.web.app,https://ganza.web.app"
JWT_SECRET="replace-with-a-cryptographically-secure-random-string"

# Firebase Admin SDK Credentials (from Google Cloud Service Account)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# Optional Integrations
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Vite / Firebase Hosting)
# ------------------------------------------------------------------------------
# Point to the live Render backend URL, e.g. https://ganza-backend1.onrender.com
# Required for the shared web app and Expo/React Native builds.
EXPO_PUBLIC_API_URL="https://ganza-backend1.onrender.com"
VITE_API_URL="https://ganza-backend1.onrender.com"

# Firebase Client Web SDK (from Firebase Console Project Settings > General)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

