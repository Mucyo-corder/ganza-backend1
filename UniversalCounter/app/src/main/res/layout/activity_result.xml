<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UNIVERSAL PRODUCT SCANNER"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#0F172A" />

        <ImageView
            android:id="@+id/resultImage"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:background="#CBD5E1" />

        <TextView
            android:id="@+id/countLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Detected objects"
            android:textColor="#475569"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/countValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textStyle="bold"
            android:textSize="28sp"
            android:textColor="#0F172A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Quality"
            android:textColor="#475569"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/qualityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOW"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#B45309" />

        <EditText
            android:id="@+id/productNameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Product name"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/quantityField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Quantity"
            android:inputType="number" />

        <EditText
            android:id="@+id/dimensionsField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Dimensions / measurement status"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/conditionField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Condition (new, used, damaged, unknown)"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/unitPriceField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Unit price (RWF)"
            android:inputType="numberDecimal" />

        <TextView
            android:id="@+id/priceStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#475569"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/totalValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Estimated market value\n0.00"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#475569"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="SAVE TO STOCK" />

            <Button
                android:id="@+id/retakeButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="📷 RETAKE PHOTO" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
