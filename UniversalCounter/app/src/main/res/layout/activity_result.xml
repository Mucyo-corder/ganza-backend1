<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UNIVERSAL PRODUCT SCANNER"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#0F172A" />

        <ImageView
            android:id="@+id/resultImage"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:background="#CBD5E1" />

        <TextView
            android:id="@+id/countLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Detected objects"
            android:textColor="#475569"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/countValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textStyle="bold"
            android:textSize="28sp"
            android:textColor="#0F172A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/decreaseCountButton"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:contentDescription="Decrease corrected count"
                android:text="-" />

            <Button
                android:id="@+id/increaseCountButton"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Increase corrected count"
                android:text="+" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Adjust detected count"
                android:textColor="#475569"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Quality"
            android:textColor="#475569"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/qualityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOW"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#B45309" />

        <EditText
            android:id="@+id/productNameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Product name"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/categoryField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Category (optional)"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/brandField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Brand (optional)"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/modelField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model (optional)"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/quantityField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Correct count"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Dimensions (enter measurements you took)"
            android:textColor="#475569"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/lengthField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Length"
                android:inputType="numberDecimal|numberSigned" />

            <EditText
                android:id="@+id/widthField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Width"
                android:inputType="numberDecimal|numberSigned" />

            <EditText
                android:id="@+id/heightField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Height"
                android:inputType="numberDecimal|numberSigned" />
        </LinearLayout>

        <Spinner
            android:id="@+id/dimensionUnitSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/conditionField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Condition (new, used, damaged, unknown)"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/unitPriceField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Unit price (RWF)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/priceSourceField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Price source URL (optional)"
            android:inputType="textUri" />

        <Button
            android:id="@+id/marketSearchButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="SEARCH CURRENT RWANDA PRICES" />

        <TextView
            android:id="@+id/priceStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#475569"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/totalValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Estimated market value\n0.00"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#475569"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="CONFIRM &amp; SAVE" />

            <Button
                android:id="@+id/retakeButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="📷 RETAKE PHOTO" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
